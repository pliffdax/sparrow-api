{
  "info": {
    "name": "Lab3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List categories (global + owned)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-User-ID", "value": "{{user_id}}", "type": "text" }
        ],
        "url": { "raw": "{{base_url}}/categories", "host": ["{{base_url}}"], "path": ["categories"] }
      },
      "response": []
    },
    {
      "name": "Create user category",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-ID", "value": "{{user_id}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Books\"\n}"
        },
        "url": { "raw": "{{base_url}}/categories", "host": ["{{base_url}}"], "path": ["categories"] }
      },
      "response": []
    },
    {
      "name": "Delete own category (allowed)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "X-User-ID", "value": "{{user_id}}" }
        ],
        "url": {
          "raw": "{{base_url}}/categories/1",
          "host": ["{{base_url}}"],
          "path": ["categories", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Delete someone else's category (forbidden)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "X-User-ID", "value": "2" }
        ],
        "url": {
          "raw": "{{base_url}}/categories/1",
          "host": ["{{base_url}}"],
          "path": ["categories", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Create record with owned category (allowed)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": 1,\n  \"category_id\": 1,\n  \"amount\": 125.5,\n  \"happened_at\": \"2025-10-30T10:00:00Z\"\n}"
        },
        "url": { "raw": "{{base_url}}/records", "host": ["{{base_url}}"], "path": ["records"] }
      },
      "response": []
    },
    {
      "name": "Create record with foreign category (forbidden)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": 2,\n  \"category_id\": 1,\n  \"amount\": 80.0,\n  \"happened_at\": \"2025-10-30T11:00:00Z\"\n}"
        },
        "url": { "raw": "{{base_url}}/records", "host": ["{{base_url}}"], "path": ["records"] }
      },
      "response": []
    }
  ]
}
