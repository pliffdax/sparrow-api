          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  try {",
                  "    const data = pm.response.json();",
                  "    if (data.access_token) {",
                  "      pm.environment.set('access_token', data.access_token);",
                  "    }",
                  "  } catch (e) {",
                  "    // ignore JSON parse error",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
